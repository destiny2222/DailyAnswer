# Daily Answer - Environment Variables

# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://your-api-url.com/api/v1

# Stripe Configuration
# Get your publishable key from: https://dashboard.stripe.com/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Cloudflare Turnstile Configuration
# Get your site key from: https://dash.cloudflare.com/
EXPO_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
